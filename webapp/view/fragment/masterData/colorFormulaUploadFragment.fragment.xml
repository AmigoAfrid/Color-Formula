<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" >
    <Dialog id="excelTableColorFormulaFragment"
        title="Color formula Excel Data"
        contentWidth="90%"
        contentHeight="60%"
        draggable="true"
        resizable="true">

        <t:Table id="colorFormulaTableFragmentId" rows="{ColorUploadModel>/Datass}" selectionMode="MultiToggle">
            <t:columns>

                <t:Column width="8rem" sortProperty="createtime"  filterProperty="color" tooltip="Color" > <!-- 0 -->
                    <Label  text="Color" />
                    <t:template>
                        <Input  value="{ColorUploadModel>color}" change="zColor_Formula_Input"   />
                    </t:template>
                </t:Column>

                <t:Column width="8rem" tooltip="Color1"><!--  1-->
                    <Label  text="Color1" />
                    <t:template>
                    <Input  value="{ColorUploadModel>color1}" />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="Colorants"><!--  2-->
                    <Label  text="Colorants" />
                    <t:template>
                    <Input  value="{ColorUploadModel>colorants}" change="zColor_Formula_Input" />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="ECC No"><!-- 4 -->
                    <Label  text="ECC No" />
                    <t:template>
                        <Input value="{ColorUploadModel>eccno}" type="Number"   />
                    </t:template>
                </t:Column>

                <t:Column width="8rem" tooltip="CI No"><!--  5-->
                    <Label  text="C I No" />
                    <t:template>
                        <Input value="{ColorUploadModel>cino}" type="Number"  />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="% of color"><!--  6-->
                    <Label  text="% of color" />
                    <t:template>
                        <Input value="{ColorUploadModel>percofcolor}" type="Number" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>
                
                <t:Column width="8rem" tooltip="size 00 Cap wt"><!-- 7 -->
                    <Label  text="size 00 Cap wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size00CaPwt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                <t:Column width="8rem" tooltip="size 00 Body wt"><!-- 8 -->
                    <Label  text="size 00 Body wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size00BodyWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="size 0el Cap wt"><!-- 9 -->
                    <Label  text="size 0el Cap wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size0elCapWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="size 0el Body wt"><!-- 10 -->
                    <Label  text="size 0el Body wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size0elBodyWt}" liveChange="onNumberInputLiveChange"  />
                    </t:template>
                </t:Column>

                    <t:Column width="8rem"  tooltip="size 0 Cap wt"><!-- 11 -->
                    <Label  text="size 0 Cap wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size0CapWt}" liveChange="onNumberInputLiveChange"  />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="size 0 Body Wt"><!-- 12 -->
                    <Label  text="size 0 Body Wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size0BodyWt}" liveChange="onNumberInputLiveChange"  />
                    </t:template>
                </t:Column>

                    <t:Column width="8rem"  tooltip="size 1 Cap wt"><!-- 13 -->
                    <Label  text="size 1 Cap wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size1CapWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="size 1 Body Wt"><!-- 14 -->
                    <Label  text="size 1 Body Wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size1BodyWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                    <t:Column width="8rem"  tooltip="size 2 Cap wt"><!-- 15 -->
                    <Label  text="size 2 Cap wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size2CapWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="size 2 Body Wt"><!-- 16 -->
                    <Label  text="size 2 Body Wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size2BodyWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                    <t:Column width="8rem"  tooltip="size 3 Cap wt"><!-- 17 -->
                    <Label  text="size 3 Cap wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size3CapWt}" liveChange="onNumberInputLiveChange"  />
                    </t:template>
                </t:Column>

                <t:Column width="8rem"  tooltip="size 3 Body Wt"><!-- 18 -->
                    <Label  text="size 3 Body Wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size3BodyWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                    <t:Column width="8rem"  tooltip="size 4 Cap wt"><!-- 19 -->
                    <Label  text="size 4 Cap wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size4CapWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>

                <t:Column width="8rem" tooltip="size 4 Body Wt"><!-- 20 -->
                    <Label  text="size 4 Body Wt" />
                    <t:template>
                        <Input value="{ColorUploadModel>size4BodyWt}" liveChange="onNumberInputLiveChange" />
                    </t:template>
                </t:Column>                         
            
            </t:columns>

           				
		</t:Table>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="Save" press=".onColorFormulaUpload_SavePress" class="sapUiTinyMargin" type="Emphasized" />
                <Button text="Cancel" press=".onColorFormulaUpload_CancelPress" class="sapUiTinyMargin" type="Emphasized" />    
            </OverflowToolbar>
        </footer>





    </Dialog>

</core:FragmentDefinition>