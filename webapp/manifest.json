        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "colorformula.view",
        "async": true,
        "viewPath": "colorformula.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        }
